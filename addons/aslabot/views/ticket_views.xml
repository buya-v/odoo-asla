<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ticket Form -->
    <record id="view_aslabot_ticket_form" model="ir.ui.view">
        <field name="name">aslabot.ticket.form</field>
        <field name="model">aslabot.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_triage" string="Triage"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_done" string="Mark Done"
                            type="object" class="btn-success"
                            invisible="state not in ('in_progress', 'executing')"/>
                    <button name="action_escalate" string="Escalate"
                            type="object" class="btn-warning"
                            invisible="state in ('done', 'failed', 'escalated')"/>
                    <button name="action_mark_failed" string="Mark Failed"
                            type="object"
                            invisible="state in ('done', 'failed', 'draft')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,triaged,in_progress,executing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Ticket Info">
                            <field name="client_id"/>
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="response_category"
                                   invisible="state == 'draft'"/>
                        </group>
                        <group string="Classification">
                            <field name="operation_type"/>
                            <field name="risk_level"/>
                            <field name="assigned_model_tier"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Operations"
                              invisible="operation_count == 0">
                            <field name="operation_plan_ids"/>
                            <field name="operation_log_ids" readonly="1"/>
                        </page>
                        <page string="Resolution"
                              invisible="state not in ('done', 'failed')">
                            <group>
                                <field name="resolution_feedback"
                                       widget="radio"/>
                                <field name="resolution_notes"/>
                            </group>
                        </page>
                        <page string="Escalation"
                              invisible="not escalated">
                            <group>
                                <field name="escalated"/>
                                <field name="escalation_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Ticket Tree -->
    <record id="view_aslabot_ticket_tree" model="ir.ui.view">
        <field name="name">aslabot.ticket.tree</field>
        <field name="model">aslabot.ticket</field>
        <field name="arch" type="xml">
            <tree string="Tickets" decoration-danger="state == 'failed'"
                  decoration-warning="state == 'escalated'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="category"/>
                <field name="operation_type"/>
                <field name="risk_level"/>
                <field name="assigned_model_tier"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Ticket Search -->
    <record id="view_aslabot_ticket_search" model="ir.ui.view">
        <field name="name">aslabot.ticket.search</field>
        <field name="model">aslabot.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Tickets">
                <field name="name"/>
                <field name="client_id"/>
                <field name="description"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_triaged" string="Triaged"
                        domain="[('state', '=', 'triaged')]"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state', 'in', ('in_progress', 'executing'))]"/>
                <filter name="filter_escalated" string="Escalated"
                        domain="[('state', '=', 'escalated')]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_high_risk" string="High Risk"
                        domain="[('risk_level', '=', 'high')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_client" string="Client"
                            context="{'group_by': 'client_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_risk" string="Risk Level"
                            context="{'group_by': 'risk_level'}"/>
                    <filter name="group_ai" string="AI Model"
                            context="{'group_by': 'assigned_model_tier'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Ticket Action -->
    <record id="action_aslabot_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">aslabot.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_aslabot_ticket_search"/>
        <field name="context">{'search_default_filter_in_progress': 1}</field>
    </record>
</odoo>
